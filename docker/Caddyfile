# Caddy configuration for 3-Tier TLS Setup (Prod: poc.d1dev.fr, Preprod: preprod-po.d1dev.fr, Dev: localhost)

poc.d1dev.fr, preprod-po.d1dev.fr, https://localhost {
    # If request is for localhost, use internal self-signed TLS.
    # Caddy automatically provisions Let's Encrypt certificates for poc.d1dev.fr and preprod-po.d1dev.fr!

    # EasyAdmin dashboard and Symfony security
    handle /admin* {
        reverse_proxy backend:8000
    }

    handle /doc* {
        reverse_proxy backend:8000
    }

    handle /login* {
        reverse_proxy backend:8000
    }

    handle /logout* {
        reverse_proxy backend:8000
    }

    # API Platform endpoints & Swagger UI
    handle /api* {
        reverse_proxy backend:8000
    }

    handle /_profiler* {
        reverse_proxy backend:8000
    }

    handle /_wdt* {
        reverse_proxy backend:8000
    }

    # React Frontend application
    handle {
        reverse_proxy frontend:5173
    }
}
