{% extends 'base.html.twig' %}

{% block title %}Architecture Documentation & Mermaid Diagrams{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2><i class="fas fa-book-reader text-primary me-2"></i>Documentation d'Architecture (Sécurisée)</h2>
        <div>
            <span class="badge bg-success"><i class="fas fa-lock me-1"></i>Accès Autorisé</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm ms-2"><i class="fas fa-sign-out-alt"></i> Déconnexion</a>
        </div>
    </div>

    <ul class="nav nav-pills mb-4" id="docTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="arch-tab" data-bs-toggle="pill" data-bs-target="#arch-pane" type="button" role="tab"><i class="fas fa-sitemap me-2"></i>Architecture Système & Séquence</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="rag-tab" data-bs-toggle="pill" data-bs-target="#rag-pane" type="button" role="tab"><i class="fas fa-robot me-2"></i>Proxy RAG & IA Mistral</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="solid-tab" data-bs-toggle="pill" data-bs-target="#solid-pane" type="button" role="tab"><i class="fas fa-cubes me-2"></i>Principes SOLID</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="deploy-tab" data-bs-toggle="pill" data-bs-target="#deploy-pane" type="button" role="tab"><i class="fas fa-server me-2"></i>Déploiement Preprod & Prod</button>
        </li>
    </ul>

    <div class="tab-content bg-white p-4 rounded shadow-sm border" id="docTabsContent">
        <div class="tab-pane fade show active" id="arch-pane" role="tabpanel">
            <div id="arch-content"></div>
        </div>
        <div class="tab-pane fade" id="rag-pane" role="tabpanel">
            <div id="rag-content"></div>
        </div>
        <div class="tab-pane fade" id="solid-pane" role="tabpanel">
            <div id="solid-content"></div>
        </div>
        <div class="tab-pane fade" id="deploy-pane" role="tabpanel">
            <div id="deploy-content"></div>
        </div>
    </div>
</div>

<!-- Libraries: Bootstrap 5, Marked.js, Mermaid.js -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        mermaid.initialize({ startOnLoad: false, theme: 'default' });

        const rawArch = {{ architectureDoc|json_encode|raw }};
        const rawRag = {{ ragDoc|json_encode|raw }};
        const rawSolid = {{ solidDoc|json_encode|raw }};
        const rawDeploy = {{ deploymentDoc|json_encode|raw }};

        function renderMarkdown(rawText, containerId) {
            const container = document.getElementById(containerId);
            container.innerHTML = marked.parse(rawText);

            // Find all code blocks with language mermaid
            const codeBlocks = container.querySelectorAll("pre code.language-mermaid");
            codeBlocks.forEach((codeBlock, idx) => {
                const pre = codeBlock.parentElement;
                const mermaidDiv = document.createElement("div");
                mermaidDiv.className = "mermaid text-center my-4";
                mermaidDiv.textContent = codeBlock.textContent;
                pre.replaceWith(mermaidDiv);
            });
        }

        renderMarkdown(rawArch, "arch-content");
        renderMarkdown(rawRag, "rag-content");
        renderMarkdown(rawSolid, "solid-content");
        renderMarkdown(rawDeploy, "deploy-content");

        mermaid.run();
    });
</script>
{% endblock %}
